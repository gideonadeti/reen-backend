# Frontend Configuration
FRONTEND_BASE_URL="http://localhost:3001"

# MongoDB Container Initialization (Docker Compose)
MONGO_INITDB_ROOT_USERNAME="admin"
MONGO_INITDB_ROOT_PASSWORD="strong-password"
MONGO_INITDB_DATABASE="reen"

# Database URLs (one per service)
AUTH_DATABASE_URL="mongodb://admin:strong-password@localhost:27017/reen-auth?authSource=admin"
PRODUCTS_DATABASE_URL="mongodb://admin:strong-password@localhost:27017/reen-products?authSource=admin"
CART-ITEMS_DATABASE_URL="mongodb://admin:strong-password@localhost:27017/reen-cart-items?authSource=admin"
ORDERS_DATABASE_URL="mongodb://admin:strong-password@localhost:27017/reen-orders?authSource=admin"

# Redis Configuration
REDIS_SERVICE_URL="redis://redis:6379"

# RabbitMQ Configuration
MESSAGE_BROKER_URL="amqp://guest:guest@rabbitmq:5672"

# Service URLs (gRPC endpoints)
AUTH_SERVICE_URL="auth:5001"
PRODUCTS_SERVICE_URL="products:5002"
CART-ITEMS_SERVICE_URL="cart-items:5003"
CHECKOUT_SERVICE_URL="checkout:5004"
ORDERS_SERVICE_URL="orders:5005"

# Clerk Configuration
CLERK_SECRET_KEY="your-clerk-secret-key"
CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"

# Stripe Configuration
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SIGNING_SECRET="your-stripe-webhook-signing-secret"

# Email Configuration (Optional)
EMAIL_SERVICE_API_KEY="your-email-service-api-key"

# Server Configuration
PORT=3000
NODE_ENV=development
