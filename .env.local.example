# Frontend Configuration
FRONTEND_BASE_URL="http://localhost:3001"

# Database URLs (one per service)
AUTH_DATABASE_URL="mongodb://localhost:27017/reen-auth?replicaSet=rs0"
PRODUCTS_DATABASE_URL="mongodb://localhost:27017/reen-products?replicaSet=rs0"
CART-ITEMS_DATABASE_URL="mongodb://localhost:27017/reen-cart-items?replicaSet=rs0"
ORDERS_DATABASE_URL="mongodb://localhost:27017/reen-orders?replicaSet=rs0"

# Redis Configuration
REDIS_SERVICE_URL="redis://localhost:6379"

# RabbitMQ Configuration
MESSAGE_BROKER_URL="amqp://guest:guest@localhost:5672"

# Service URLs (gRPC endpoints)
AUTH_SERVICE_URL="localhost:5000"
PRODUCTS_SERVICE_URL="localhost:5001"
CART-ITEMS_SERVICE_URL="localhost:5002"
CHECKOUT_SERVICE_URL="localhost:5003"
ORDERS_SERVICE_URL="localhost:5004"

# JWT Configuration
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"

# Clerk Configuration
CLERK_SECRET_KEY="your-clerk-secret-key"
CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"

# Stripe Configuration
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SIGNING_SECRET="your-stripe-webhook-signing-secret"

# Email Configuration
GOOGLE_APP_PASSWORD="your-google-app-password"

# Server Configuration
PORT=3000
NODE_ENV=development
